# --- Obligatorias ---
UBERSMITH_API_URL=https://billing.mycompany.com/api/2.0/
UBERSMITH_API_USER=mi_usuario
UBERSMITH_API_TOKEN=mi_token_o_password

# MySQL: la MISMA instancia y base que ConnexMonitor (desconexiones).
MYSQL_HOST=db.mycompany.com
MYSQL_USER=connex
MYSQL_PASSWORD=mi_password
MYSQL_DATABASE=connexmonitor
# MYSQL_PORT=3306
# MYSQL_SSL_CA=/ruta/ca.pem

# --- Opcionales ---

# CONNEX_DRY_RUN=1                  # 1 (default) = no crea tickets ni escribe circuitos; 0 = real
# CONNEX_QUEUE_RECONNECT=57         # cola de reconexión (si no, SUPPORT_QUEUE_ID)
# SUPPORT_QUEUE_ID=57               # cola por defecto
# CONNEX_CONCURRENCY=8              # clientes procesados a la vez
# CONNEX_PAGE_SIZE=1000             # ítems por petición paginada a Ubersmith
# CONNEX_INTERVAL_SECONDS=3600      # segundos entre ciclos
# CONNEX_DAILY_AT=06:00             # una ejecución diaria a esta hora (America/Puerto_Rico); anula el intervalo
# CONNEX_RUN_DAYS=mon,tue,wed,thu,fri,sat,sun  # reconexiones: todos los días
# CONNEX_RUN_ON_START=0             # 1 = además ejecuta un ciclo al arrancar (solo con CONNEX_DAILY_AT)
# CONNEX_LOCK_TTL_SECONDS=1800      # candado 'reconnect_cycle' en connex_lock; se renueva por cliente
# CONNEX_OPEN_TICKET_MAX_AGE_DAYS=5 # no postear si hay ticket de reconexión abierto reciente; también es la pausa tras un fallo
# CONNEX_INTERNAL_TICKET=1          # 1 = ticket interno
# CONNEX_NO_NOTIFICATION=1          # 1 = sin email al crear el ticket
# CONNEX_TICKET_PRIORITY=1          # 0 baja, 1 normal, 2 alta, 3 urgente
# CONNEX_TICKET_AUTHOR=bot@mycompany.com
